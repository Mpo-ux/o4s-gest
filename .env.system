# Configurações do Sistema O4S Gest

## Portas de Desenvolvimento
PORT_FRONTEND_PREFERRED=3000
PORT_FRONTEND_FALLBACK=3001
PORT_BACKEND=5000

## Configurações de Inicialização
AUTO_KILL_NODE_PROCESSES=true
AUTO_CHECK_PORTS=true
SYSTEM_HEALTH_CHECK_TIMEOUT=10000

## URLs de Conexão
BACKEND_URL=http://localhost:5000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001

## Configurações de Desenvolvimento
DEV_MODE=true
DEV_AUTO_LOGIN=false
DEV_SHOW_SYSTEM_DETAILS=true

## Scripts PowerShell
ENABLE_POWERSHELL_SCRIPTS=true
SCRIPT_EXECUTION_TIMEOUT=30000

## Configurações de Logs
LOG_LEVEL=debug
LOG_SYSTEM_CHECKS=true
LOG_PORT_MANAGEMENT=true